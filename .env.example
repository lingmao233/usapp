# 「我们」环境配置。复制为 server/.env（本地开发）或项目根目录 .env（docker compose 读取根目录）后按需填写。
# 不填任何 key 也能跑：AI 自动进入 mock 模式（本地确定性桩）。

# ---------- 文本 LLM（OpenAI 兼容 chat/completions）：分类/摘要/周报/方案/画像 ----------
# 三组参数同厂商时只需填 LLM_API_KEY：EMBEDDING_* / VISION_* 的 KEY 与 BASE_URL 会自动回退到 LLM 组
LLM_API_KEY=
# 阿里百炼示例：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
# 阿里百炼示例：LLM_MODEL=qwen-plus
LLM_MODEL=

# ---------- Embedding（OpenAI 兼容 /embeddings，纯文本向量）：相关推荐/共同愿望/知识库搜索 ----------
# EMBEDDING_API_KEY=    # 留空回退 LLM_API_KEY
# EMBEDDING_BASE_URL=   # 留空回退 LLM_BASE_URL
# 阿里百炼示例：EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_MODEL=
# 向量维度（调用时显式传）。更换模型/维度后必须跑 scripts/reembed.py 回填全库
# EMBEDDING_DIM=1024

# ---------- 视觉模型（可选）：图片 caption / 账单识别 / 食物识别 ----------
# VISION_MODEL 留空 = 视觉关闭，相关功能自动优雅跳过（手动录入兜底）
# VISION_API_KEY=     # 留空回退 LLM_API_KEY
# VISION_BASE_URL=    # 留空回退 LLM_BASE_URL
# 阿里百炼低延迟识别推荐：VISION_MODEL=qwen3-vl-flash
# VISION_MODEL=
# 阿里 Qwen3-VL：none/minimal/空均显式关闭思考；简单账单抽取不要开启
# 其他 OpenAI 兼容厂商：非空值按 reasoning_effort 原样传递
# VISION_REASONING=none

# 高德开放平台 Web 服务 key（可选）：方案里的景点/酒店/天气/通勤用真实数据；
# 留空 = 方案走纯 LLM 经验推荐。申请：lbs.amap.com → 个人开发者认证 → Web 服务类型 key
# AMAP_KEY=你的高德key
# 高德安全密钥（新建 key 已强制绑定）：填控制台里与 key 绑定的私钥，请求自动带 sig 数字签名；
# 老 key 若未绑定安全密钥，此项留空即可
# AMAP_SECRET=你的安全密钥

# 身份码找回的特定码（可选，多个用英文逗号分隔，汉字/字母均可）：
# 填了才开放「按名字找回身份码」（登录页 → 用恢复码找回身份 → 按名字找回）；留空 = 一律拒绝
# 注意：身份码即登录凭证，特定码要当密码保管，泄露即换
# RECOVERY_ACCESS_CODES=芝麻开门,opensesame

# Redis（可选。本地开发用，连不上时自动降级为进程内字典并打 warning；
# docker compose 部署时无需配置——compose 已内置指向同网络的 redis 服务，以此文件里的值为忽略）
REDIS_URL=redis://localhost:6379/0

# SQLite 数据库文件路径。
# 本地默认 server/data/app.db；docker compose 里固定为 /app/server/data/app.db（volume 持久化）
# DB_PATH=
