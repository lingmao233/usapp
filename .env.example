# 「我们」环境配置。复制为 server/.env（本地开发）或项目根目录 .env（docker compose 读取根目录）后按需填写。
# 不填任何 key 也能跑：AI 自动进入 mock 模式（本地确定性桩）。

# DeepSeek（OpenAI 兼容格式）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 豆包 Embedding（火山方舟 OpenAI 兼容接口，多模态 embedding）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision-250615

# 多模态向量维度：文字与图片显式同传（doubao-embedding-vision 最小支持 1024，512 会被拒）
# DOUBAO_EMBED_DIM=1024

# 视觉模型（图片 caption，可选）：开通一个视觉模型后填模型名或接入点 ID；留空 = 自动跳过 caption
# DOUBAO_VISION_MODEL=doubao-vision-lite-32k

# Redis（可选。本地开发用，连不上时自动降级为进程内字典并打 warning；
# docker compose 部署时无需配置——compose 已内置指向同网络的 redis 服务，以此文件里的值为忽略）
REDIS_URL=redis://localhost:6379/0

# SQLite 数据库文件路径。
# 本地默认 server/data/app.db；docker compose 里固定为 /app/server/data/app.db（volume 持久化）
# DB_PATH=
